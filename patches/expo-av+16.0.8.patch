+
+#ifndef EXLogWarn
+#define EXLogWarn(...) NSLog(__VA_ARGS__)
+#endif
+
+#ifndef EXLogError
+#define EXLogError(...) NSLog(__VA_ARGS__)
+#endif
+
+#ifndef EXLogInfo
+#define EXLogInfo(...) NSLog(__VA_ARGS__)
+#endif
+
+#ifndef EXFatal
+#define EXFatal(error) NSLog(@"[expo-av] Fatal error: %@", (error))
+#endif
+
+NS_ASSUME_NONNULL_END
